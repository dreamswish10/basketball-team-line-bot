# LINE Bot (Messaging API channel) 設定
# 從 LINE Developers Console 的 Messaging API channel 取得
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# LIFF（網頁檢視）設定
# ⚠️ 2024 起 LIFF 必須建在「LINE Login channel」，不能加在 Messaging API channel。
# 步驟：到 LINE Developers Console，於同一 Provider 下「Create a new channel → LINE Login」，
# 進去後在 LIFF 分頁 Add LIFF app，Endpoint URL 設為 https://<your-domain>/view
LIFF_ID=your_liff_id_here
# 上面那支 LINE Login channel 的 Channel ID（純數字，在 Basic settings 頁）
LIFF_CHANNEL_ID=your_login_channel_id_here
# 部署網域，用來組 LIFF Endpoint URL（例：https://xxx.onrender.com）
PUBLIC_BASE_URL=https://your-domain.example.com

# Flask 應用程式設定
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=your-secret-key-for-production

# 資料庫設定（可選，預設使用 SQLite）
DATABASE_URL=sqlite:///basketball_teams.db

# 伺服器設定
PORT=5000
HOST=0.0.0.0

# 日誌設定
LOG_LEVEL=INFO